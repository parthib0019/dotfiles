* {
	border: none;
	border-radius: 10;
	font-family: "SF Pro", "JetbrainsMono Nerd Font";
	font-weight: 600;
	font-size: 15px;
	min-height: 10px;
}

window#waybar {
	background: transparent;
}

window#waybar.hidden {
	opacity: 0.2;
}

#window {
	margin-top: 6px;
	padding-left: 10px;
	padding-right: 10px;
	border-radius: 10px;
	transition: none;
	color: #000000;
	background: transparent;
}

/* Grouped Panels containers */
.modules-left {
	background-color: #ffffff;
	color: #000000;
	border-radius: 10px;
	margin-top: 6px;
	margin-bottom: 0px;
	margin-left: 8px;
	padding-top: 2px;
	padding-bottom: 2px;
}

.modules-right {
	background-color: #ffffff;
	color: #000000;
	border-radius: 10px;
	margin-top: 6px;
	margin-bottom: 0px;
	margin-right: 8px;
	padding-top: 2px;
	padding-bottom: 2px;
}

#workspaces {
	margin-top: 6px;
	margin-left: 8px;
	padding-top: 2px;
	padding-bottom: 2px;
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 10px;
	transition: none;
	color: #000000;
	background: #ffffff;
}

#workspaces button {
	color: #000000;
	background-color: transparent;
	border-radius: 10px;
	padding-left: 5px;
	padding-right: 5px;
}

#workspaces button.active {
	background-color: #000000;
	color: #ffffff;
}

#mpris {
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 0px;
	transition: none;
	background: transparent;
	color: #000000;
	transition: all 200ms;
	margin-top: 0px;
	margin-left: 0px;
}

#mpris.paused {
	color: #000000;
}

#network {
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 0px;
	transition: none;
	border-left: 2px solid #000000;
	color: #000000;
	background: transparent;
	margin-top: 0px;
	margin-left: 0px;
}

#pulseaudio {
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 0px;
	border-left: 2px solid #000000;
	transition: none;
	color: #000000;
	background: transparent;
	margin-top: 0px;
	margin-left: 0px;
}

#battery {
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 0px;
	transition: none;
	color: #000000;
	background: transparent;
	margin-top: 0px;
	margin-left: 0px;
}

#battery.charging, #battery.plugged {
	color: #161320;
	background-color: #B5E8E0;
}

#battery.critical:not(.charging) {
	background-color: #B5E8E0;
	color: #161320;
	animation-name: blink;
	animation-duration: 0.5s;
	animation-timing-function: linear;
	animation-iteration-count: infinite;
	animation-direction: alternate;
}

@keyframes blink {
	to {
		background-color: #BF616A;
		color: #B5E8E0;
	}
}

#backlight {
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 0px;
	transition: none;
	color: #000000;
	background: transparent;
	margin-top: 0px;
	margin-left: 0px;
}

#clock {
	padding-left: 10px;
	padding-right: 10px;
	margin-bottom: 0px;
	border-radius: 0px;
	border-right: 2px solid #000000;
	transition: none;
	color: #000000;
	background: transparent;
	margin-top: 0px;
	margin-left: 0px;
}

#memory {
	padding-left: 10px;
	margin-bottom: 0px;
	padding-right: 10px;
	border-radius: 0px;
	border-right: 2px solid #000000;
	transition: none;
	color: #000000;
	background: transparent;
	margin-top: 0px;
	margin-left: 0px;
}

#cpu {
	padding-left: 10px;
	margin-bottom: 0px;
	padding-right: 10px;
